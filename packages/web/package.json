{
  "name": "@jindun/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JinDun Sentinel web front end (Vue 3 + Vite + Element Plus + ECharts).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
