# Keep the build context small and the images reproducible.
#
# The context is the repository root, because the web build reads the locale
# catalogue and the methodology documents from there.

.git
.github
.venv
venv
node_modules
dist
.scratch
.pytest_cache
.ruff_cache
.mypy_cache
__pycache__
*.pyc
*.pyo
*.egg-info

# A pattern without a slash matches the root of the build context only, so the
# nested copies are listed as well.  Otherwise the front end's node_modules
# and the bundle it was built into would travel into the context.
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/.pytest_cache
**/.ruff_cache

# Bulky and reproducible: the BIS bulk archive is 365 MB and the raw source
# snapshots are fetched, never committed.
data/cache
data/snapshots

# The artefacts are mounted at run time, not baked into the image.
data/runs
data/baseline
